# Catatan nilai konfigurasi MR. PLANER Telegram.
# n8n tidak membaca file ini. Nilainya dimasukkan ke credential n8n atau ke placeholder
# di file workflow (lihat README). Salin ke .env.local lalu isi; .env.local tidak ikut di-commit.

# Telegram: @BotFather -> /mybots -> pilih bot -> API Token
TELEGRAM_BOT_TOKEN=

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres untuk credential n8n. Ambil dari tombol Connect -> Session pooler.
# Jangan pakai db.<project-ref>.supabase.co (hanya IPv6, tidak terjangkau dari server n8n).
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# Groq: console.groq.com -> API Keys. Key cadangan diambil dari akun Groq lain.
GROQ_API_KEY=
GROQ_BACKUP_API_KEY=

# SerpAPI, dipakai WF-04 untuk Google Trends
SERPAPI_KEY=

# Google Cloud OAuth client untuk credential "Google Sheets OAuth2 API" di n8n
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# n8n
N8N_BASE_URL=https://n8n.example.com
# Nilai header x-internal-secret antar workflow, misalnya hasil: openssl rand -hex 16
N8N_WEBHOOK_SECRET=
