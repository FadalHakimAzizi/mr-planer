                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://api.groq.com/openai/v1/chat/completions",
                                         "authentication":  "genericCredentialType",
                                         "genericAuthType":  "httpHeaderAuth",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ JSON.stringify({ model: \u0027meta-llama/llama-4-scout-17b-16e-instruct\u0027, messages: [{ role: \u0027user\u0027, content: $json.prompt }], temperature: 0.5, max_tokens: 800 }) }}",
                                         "options":  {
