                                                       }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const products = $input.all().map(function(i){return i.json;});\nconst monthNames = [\u0027Januari\u0027,\u0027Februari\u0027,\u0027Maret\u0027,\u0027April\u0027,\u0027Mei\u0027,\u0027Juni\u0027,\u0027Juli\u0027,\u0027Agustus\u0027,\u0027September\u0027,\u0027Oktober\u0027,\u0027November\u0027,\u0027Desember\u0027];\nconst now = new Date();\nconst monthYear = monthNames[now.getMonth()] + \u0027 \u0027 + now.getFullYear();\n\nreturn products.map(function(p){\n  const target = p.target_market || \u0027umum\u0027;\n  const prompt = \u0027Kamu adalah SEO analyst untuk affiliator TikTok Indonesia.\\n\\nProduk: \u0027 + p.name + \u0027\\nTarget market: \u0027 + target + \u0027\\nPeriode: \u0027 + monthYear + \u0027\\n\\nTugas: hasilkan 8 keyword pencarian paling relevan \u0026 trending di Indonesia (TikTok + Google) untuk produk ini. Sertakan mix:\\n- 2 keyword review/perbandingan (cth: \u003cproduk\u003e vs ...)\\n- 2 keyword price-driven (cth: \u003cproduk\u003e murah, diskon)\\n- 2 keyword use-case (cth: cara pakai, untuk pemula)\\n- 2 keyword trending umum (cth: tahun terkini, rekomendasi)\\n\\nUntuk tiap keyword, beri score 0-100 (estimasi search intent strength + relevansi trending bulan ini).\\n\\nOUTPUT HANYA JSON valid (tanpa markdown, tanpa preamble):\\n{\\n  \"keywords\": [\\n    {\"keyword\": \"frase pencarian\", \"score\": 75},\\n    ...\\n  ]\\n}\u0027;\n\n  return { json: { productId: p.id, productName: p.name, prompt: prompt } };\n});"
                                     },
                      "id":  "build-prompt",
                      "name":  "Build Keyword Prompt",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
