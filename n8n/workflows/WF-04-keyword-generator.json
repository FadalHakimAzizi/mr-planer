                                         "jsCode":  "const expected = 'YOUR_INTERNAL_SECRET';\nconst headers = $json.headers || {};\nconst got = headers[\u0027x-internal-secret\u0027] || headers[\u0027X-Internal-Secret\u0027];\nif (got !== expected) {\n  throw new Error(\u0027Unauthorized: invalid or missing x-internal-secret header\u0027);\n}\nreturn $input.all();"
