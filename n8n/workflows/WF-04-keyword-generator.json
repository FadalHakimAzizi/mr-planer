                                                                                        "batchInterval":  2000
                                                                                    }
                                                                      }
                                                     }
                                     },
                      "id":  "generate-keywords",
                      "name":  "Generate Keywords with AI",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       1136,
                                       352
                                   ],
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  5000,
                      "credentials":  {
                                          "httpHeaderAuth":  {
                                                                 "id":  "",
                                                                 "name":  "Groq API"
                                                             }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "function extractJSON(raw){\n  if(!raw) return null;\n  const s = String(raw).replace(/```json/gi,\u0027\u0027).replace(/```/g,\u0027\u0027).trim();\n  const i = s.indexOf(\u0027{\u0027);\n  if(i === -1) return null;\n  let depth=0, end=-1, inStr=false, esc=false;\n  for(let k=i; k\u003cs.length; k++){\n    const ch=s[k];\n    if(esc){esc=false; continue;}\n    if(ch===\u0027\\\\\u0027){esc=true; continue;}\n    if(ch===\u0027\"\u0027){inStr=!inStr; continue;}\n    if(inStr) continue;\n    if(ch===\u0027{\u0027) depth++;\n    else if(ch===\u0027}\u0027){ depth--; if(depth===0){end=k; break;} }\n  }\n  if(end===-1) return null;\n  try { return JSON.parse(s.slice(i, end+1)); } catch(e) { return null; }\n}\n\nconst responses = $input.all();\nconst prompts = $(\u0027Build Keyword Prompt\u0027).all().map(function(i){return i.json;});\n\nconst out = [];\nresponses.forEach(function(res, idx){\n  const p = prompts[idx];\n  if (!p) return;\n  const content = res.json \u0026\u0026 res.json.choices \u0026\u0026 res.json.choices[0] \u0026\u0026 res.json.choices[0].message ? res.json.choices[0].message.content : \u0027\u0027;\n  const parsed = extractJSON(content) || { keywords: [] };\n  const kws = Array.isArray(parsed.keywords) ? parsed.keywords : [];\n  kws.forEach(function(k){\n    if (!k || !k.keyword) return;\n    out.push({ json: {\n      productId: p.productId,\n      productName: p.productName,\n      keyword: String(k.keyword).slice(0, 200),\n      trendScore: Math.max(0, Math.min(100, parseInt(k.score, 10) || 50))\n    }});\n  });\n});\n\nreturn out;"
                                     },
