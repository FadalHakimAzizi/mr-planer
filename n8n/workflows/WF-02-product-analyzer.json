                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://api.groq.com/openai/v1/chat/completions",
                                         "authentication":  "genericCredentialType",
                                         "genericAuthType":  "httpHeaderAuth",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ JSON.stringify({ model: \u0027meta-llama/llama-4-scout-17b-16e-instruct\u0027, messages: [{ role: \u0027user\u0027, content: [{ type: \u0027image_url\u0027, image_url: { url: $json.imageUrl } }, { type: \u0027text\u0027, text: \u0027Kamu adalah AI product analyst untuk affiliator TikTok Indonesia. Analisis gambar produk ini.\\n\\nINSTRUKSI KETAT:\\n- Output HANYA berupa JSON valid, TANPA kalimat pembuka, TANPA penjelasan, TANPA markdown code fences.\\n- Mulai response langsung dengan { dan akhiri dengan }.\\n- Gunakan bahasa Indonesia untuk semua value.\\n\\nFormat output:\\n{\"name\":\"nama produk lengkap (brand + tipe)\",\"selling_points\":[\"keunggulan 1\",\"keunggulan 2\",\"keunggulan 3\",\"keunggulan 4\",\"keunggulan 5\"],\"target_market\":\"deskripsi target market/pembeli\",\"use_cases\":[\"use case 1\",\"use case 2\",\"use case 3\"]}\u0027 }] }], temperature: 0.5, max_tokens: 1024 }) }}",
                                         "options":  {

                                                     }
                                     },
                      "id":  "226ae95a-280e-4da1-844d-d92070cc88f3",
                      "name":  "Analyze with Groq",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       2288,
                                       608
                                   ],
                      "credentials":  {
                                          "httpHeaderAuth":  {
                                                                 "id":  "",
                                                                 "name":  "Groq API"
                                                             }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "function extractJSON(raw) {\n  if (!raw) return null;\n  let s = String(raw).replace(/```json/gi, \u0027\u0027).replace(/```/g, \u0027\u0027).trim();\n  const firstBrace = s.indexOf(\u0027{\u0027);\n  if (firstBrace === -1) return null;\n  let depth = 0, end = -1, inString = false, escape = false;\n  for (let i = firstBrace; i \u003c s.length; i++) {\n    const ch = s[i];\n    if (escape) { escape = false; continue; }\n    if (ch === \u0027\\\\\u0027) { escape = true; continue; }\n    if (ch === \u0027\"\u0027) { inString = !inString; continue; }\n    if (inString) continue;\n    if (ch === \u0027{\u0027) depth++;\n    else if (ch === \u0027}\u0027) { depth--; if (depth === 0) { end = i; break; } }\n  }\n  if (end === -1) return null;\n  try { return JSON.parse(s.slice(firstBrace, end + 1)); } catch(e) { return null; }\n}\n\nconst raw = ($json.choices \u0026\u0026 $json.choices[0] \u0026\u0026 $json.choices[0].message \u0026\u0026 $json.choices[0].message.content)\n  ? $json.choices[0].message.content : \u0027\u0027;\n\nconst parsed = extractJSON(raw) || { name: \u0027Produk\u0027, selling_points: [], target_market: \u0027\u0027, use_cases: [] };\n\nconst btu = $(\u0027Build Telegram URL\u0027).item.json;\nconst chatId = String(btu.chatId || \u0027\u0027);\n\nreturn [{ json: {\n  name: parsed.name || \u0027Produk\u0027,\n  description: btu.description || \u0027\u0027,\n  image_url: btu.imageUrl || \u0027\u0027,\n  selling_points: Array.isArray(parsed.selling_points) ? parsed.selling_points : [],\n  target_market: parsed.target_market || \u0027\u0027,\n  use_cases: Array.isArray(parsed.use_cases) ? parsed.use_cases : [],\n  user_id: btu.dbUserId,\n  chatId: chatId,\n  telegramUserId: btu.telegramUserId,\n  _rawAI: String(raw).substring(0, 500)\n}}];"
                                     },
                      "id":  "3946c9e3-56df-4cf3-bc73-9d6e99822494",
                      "name":  "Parse AI Response",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       2512,
                                       608
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "function esc(v){ return String(v||\"\").replace(/\u0027/g, \"\u0027\u0027\"); }\n\nconst j = $json;\n\nconst chatId = String(j.chatId || \"\");\nif (!chatId) throw new Error(\u0027chatId kosong di Prepare SQL! Cek input webhook.\u0027);\n\nconst sp = JSON.stringify(Array.isArray(j.selling_points) ? j.selling_points : []);\n\nconst sql = \"INSERT INTO public.products (user_id, name, description, image_url, selling_points, target_market) VALUES (\u0027\" +\n  esc(j.user_id) + \"\u0027, \u0027\" + esc(j.name) + \"\u0027, \u0027\" + esc(j.description) + \"\u0027, \u0027\" +\n  esc(j.image_url) + \"\u0027, \u0027\" + esc(sp) + \"\u0027, \u0027\" + esc(j.target_market) +\n\"\u0027) RETURNING id, name\";\n\nconst spLines = (j.selling_points || []).slice(0, 3)\n  .map(function(s, i) { return (i + 1) + \u0027. \u0027 + String(s).substring(0, 80); })\n  .join(\u0027\\n\u0027);\n\nconst telegramMessage =\n  \u0027\\u2705 Analisis Produk Selesai!\\n\\n\u0027 +\n  \u0027\\ud83d\\udce6 Produk: \u0027 + (j.name || \u0027-\u0027) + \u0027\\n\\n\u0027 +\n  \u0027\\ud83c\\udfaf Target Market: \u0027 + (j.target_market || \u0027-\u0027) + \u0027\\n\\n\u0027 +\n  \u0027\\u2b50 Selling Points:\\n\u0027 + (spLines || \u0027-\u0027) + \u0027\\n\\n\u0027 +\n  \u0027Ketik /create untuk buat content plan!\u0027;\n\nreturn [{ json: { ...j, chatId, sql, telegramMessage } }];"
                                     },
