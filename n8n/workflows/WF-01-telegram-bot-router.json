                      "parameters":  {
                                         "jsCode":  "const msg = $json.message;\nconst callbackQuery = $json.callback_query;\n\nlet chatId, userId, username, text, photo, command, args;\nlet isCallback = false;\nlet callbackData = null;\nlet callbackQueryId = null;\nlet durationDays = 7;\nlet rowNumber = 1;\n\nif (callbackQuery) {\n  isCallback = true;\n  callbackData = callbackQuery.data || \u0027\u0027;\n  callbackQueryId = callbackQuery.id;\n  chatId = callbackQuery.message \u0026\u0026 callbackQuery.message.chat ? callbackQuery.message.chat.id : null;\n  userId = callbackQuery.from ? callbackQuery.from.id : null;\n  username = (callbackQuery.from \u0026\u0026 (callbackQuery.from.username || callbackQuery.from.first_name)) || \u0027User\u0027;\n  text = \u0027\u0027;\n  photo = null;\n  command = null;\n  args = \u0027\u0027;\n  if (callbackData.indexOf(\u0027plan_\u0027) === 0) {\n    command = \u0027__callback_plan__\u0027;\n    const n = parseInt(callbackData.replace(\u0027plan_\u0027, \u0027\u0027), 10);\n    if (n === 7 || n === 30) durationDays = n;\n  } else if (callbackData === \u0027show_history\u0027) {\n    command = \u0027/history\u0027;\n  } else if (callbackData === \u0027show_analyze_help\u0027) {\n    command = \u0027/analyze\u0027;\n  }\n} else if (msg) {\n  text = msg.text || msg.caption || \u0027\u0027;\n  chatId = msg.chat \u0026\u0026 msg.chat.id;\n  userId = msg.from \u0026\u0026 msg.from.id;\n  username = (msg.from \u0026\u0026 (msg.from.username || msg.from.first_name)) || \u0027User\u0027;\n  photo = msg.photo;\n  command = (text.trim().split(/\\s+/).find(function(w){ return w.indexOf(\u0027/\u0027) === 0; }) || \u0027\u0027).split(\u0027@\u0027)[0] || null;\n  args = command ? text.trim().split(/\\s+/).filter(function(w){ return w.indexOf(\u0027/\u0027) !== 0; }).join(\u0027 \u0027).trim() : text;\n  if (command === \u0027/help\u0027 || command === \u0027/script\u0027 || command === \u0027/menu\u0027) command = \u0027/start\u0027;\n  if (command === \u0027/create\u0027) {\n    const argNum = parseInt(args, 10);\n    if (argNum === 7 || argNum === 30) durationDays = argNum;\n  }\n}\n\nreturn [{ json: { chatId, userId, username, text, command, args, photo, hasPhoto: !!(photo \u0026\u0026 photo.length \u003e 0), isCallback, callbackData, callbackQueryId, durationDays, rowNumber, raw: $json } }];"
                                     },
